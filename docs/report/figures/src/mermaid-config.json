{
  "theme": "neutral",
  "themeVariables": {
    "fontFamily": "Times New Roman, Times, serif",
    "fontSize": "16px",
    "primaryColor": "#f4f4f4",
    "primaryBorderColor": "#333333",
    "primaryTextColor": "#000000",
    "lineColor": "#333333",
    "clusterBkg": "#fbfbfb",
    "clusterBorder": "#777777"
  },
  "flowchart": {
    "curve": "basis",
    "nodeSpacing": 22,
    "rankSpacing": 24,
    "padding": 6,
    "htmlLabels": true,
    "useMaxWidth": false
  },
  "state": {
    "nodeSpacing": 22,
    "rankSpacing": 22,
    "useMaxWidth": false
  },
  "er": {
    "useMaxWidth": false,
    "fontSize": 16,
    "entityPadding": 8,
    "minEntityWidth": 60,
    "minEntityHeight": 40
  }
}