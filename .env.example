# Copy to .env (make up does this if .env is missing). Placeholders only: never commit real values.
# Every gateway setting has the AGW_ prefix (docs/gateway/00-repository-setup.md §7).
# Secrets may alternatively be supplied as AGW_<NAME>_FILE=/path/to/file.

# --- docker compose (Postgres 16) ---
POSTGRES_PASSWORD=change-me
AGW_MIGRATOR_PASSWORD=change-me
AGW_APP_PASSWORD=change-me
# Host port for the compose Postgres (5432 is often taken by a local install).
AGW_PG_HOST_PORT=54329

# --- gateway ---
AGW_ENV=dev
AGW_DATABASE_URL=postgresql+psycopg://agw_app:change-me@localhost:54329/agw
AGW_MIGRATOR_DATABASE_URL=postgresql+psycopg://agw_migrator:change-me@localhost:54329/agw
AGW_LOG_LEVEL=INFO
AGW_EXECUTOR_MODE=inprocess
AGW_DEMO_SANDBOX_DIR=./.sandbox
AGW_DEMO_CORPUS_DIR=./examples/single-agent/corpus

# --- risk engine + risk-adaptive sealing (Phase 4, ADR-0026); defaults shown, all optional ---
# AGW_RISK_POLICY_FILE=            # TOML risk policy; empty = bundled default_risk_policy.toml
# AGW_RISK_POLICY_ID=risk-default
# AGW_EPOCH_MAX_EVENTS=100         # LOW
# AGW_EPOCH_MAX_AGE_SECONDS=300    # LOW
# AGW_EPOCH_MEDIUM_MAX_EVENTS=25
# AGW_EPOCH_MEDIUM_MAX_AGE_SECONDS=60
# AGW_SEAL_ADAPTIVE=true           # false = Phase 3 fixed count/age sealing
# AGW_SEAL_COUNT_BASIS=lowest      # lowest | strictest
# AGW_WORKER_METRICS_PORT=         # e.g. 9464 -> http://127.0.0.1:9464/metrics

# --- action-bound human approval (Phase 5, ADR-0027) ---
# Gateway-held Ed25519 decision-signing key (dev). `make dev-keys` creates it (git-ignored).
# Missing/unreadable -> approval decisions fail closed (503); actions stay pending, then expire.
AGW_APPROVAL_SIGNING_KEY_FILE=./secrets/approval-signing.key
# AGW_APPROVAL_TTL_SECONDS_MEDIUM=900
# AGW_APPROVAL_TTL_SECONDS_HIGH=900
# AGW_APPROVAL_TTL_SECONDS_CRITICAL=900
# AGW_APPROVAL_FOUR_EYES_CRITICAL=true   # CRITICAL needs two distinct approvers
# AGW_APPROVAL_SWEEP_SECONDS=5
# AGW_HUMAN_SESSION_TTL_MINUTES=480
# AGW_ACTION_LONG_POLL_MAX_SECONDS=30
# Approver CLI (agw-approve). Never put a real password in this file.
# AGW_APPROVER_TENANT=demo
# AGW_APPROVER_USER=alice
# AGW_APPROVER_PASSWORD=change-me

# --- blockchain anchoring (Phase 6, ADR-0028) ---
# Unset RPC URL = no anchoring: epochs stay "locally sealed only", and CRITICAL actions that
# require pre-action anchoring (AGW_PRE_ANCHOR_RULES) time out and fail closed (ANCHOR_TIMEOUT).
# `make anchor-deploy-anvil` (needs `make up`) deploys to the compose Anvil and creates the dev
# key files below from Anvil's PUBLIC test mnemonic. make demo sets these for itself.
# AGW_ANCHOR_RPC_URL=http://127.0.0.1:8545          # may embed a provider API key: secret
# AGW_ANCHOR_CHAIN_ID=31337                         # Base Sepolia: 84532
# AGW_ANCHOR_CONTRACT=0x0000000000000000000000000000000000000000   # from contracts/deployments/
# AGW_ANCHOR_SUBMITTER_KEY_FILE=./secrets/anchor-submitter.key     # hex key, 0600, never logged
# AGW_ANCHOR_DEPLOYMENT_SALT_FILE=./secrets/anchor-salt.hex        # 32-byte hex recorder-id salt
# AGW_ANCHOR_FINALITY=finalized        # included | confirmations:<N> | safe | finalized (Anvil: confirmations:2)
# AGW_ANCHOR_ROUTINE_DELAY_SECONDS=60  # ROUTINE epochs wait to batch; PRIORITY/CRITICAL go next tick
# AGW_ANCHOR_POLL_SECONDS=2
# AGW_ANCHOR_MAX_INFLIGHT=8
# AGW_ANCHOR_GAS_LIMIT=200000
# AGW_ANCHOR_ALERT_AGE_SECONDS=900     # alert when the oldest unanchored epoch is older
# AGW_PRE_ANCHOR_RULES=*               # "*" = every CRITICAL action; or rule ids, comma-separated
# AGW_CRITICAL_ANCHOR_TIMEOUT_SECONDS=120
# AGW_ANVIL_HOST_PORT=8545

# --- encryption, key management, disclosure (Phase 7, ADR-0029) ---
# KEK keyring: a directory OUTSIDE any git checkout, one file per version (<id>.v<N>.key, 0600).
# `make dev-kek` creates it. No usable KEK -> nothing with a payload is written (503) and
# /v1/ready is 503. Never put key material in this file.
AGW_KEK_DIR=~/.agw/kek
AGW_KEK_ID=dev
# AGW_KEK_ACTIVE_VERSION=         # default: the highest version present
# AGW_KEY_PROVIDER=local          # local | vault
# AGW_VAULT_ADDR=http://127.0.0.1:8200
# AGW_VAULT_TOKEN_FILE=           # secret: prefer the _FILE form
# AGW_VAULT_TRANSIT_KEY=agw-kek
# Object storage (MinIO, S3 API) for payload ciphertexts above the threshold. The compose
# `minio` service uses these as its root credentials (placeholders: change them).
AGW_BLOB_ENDPOINT=127.0.0.1:9000
AGW_BLOB_ACCESS_KEY=agw-minio-change-me
AGW_BLOB_SECRET_KEY=change-me-minio-secret
AGW_BLOB_SECURE=false
# AGW_BLOB_BUCKET=agw-payloads
# AGW_PAYLOAD_BLOB_THRESHOLD_BYTES=65536
# AGW_RETENTION_SWEEP_SECONDS=3600
# AGW_DISCLOSURE_MAX_EVENTS=200

# --- demo agent (examples/single-agent) ---
AGW_GATEWAY_URL=http://127.0.0.1:8080
# Optional LLM agent (--llm flag only, never in CI):
# ANTHROPIC_API_KEY=change-me
