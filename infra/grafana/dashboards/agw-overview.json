   "id": 1,
   "type": "timeseries",
   "title": "Decisions by effect and risk (rate)",
   "datasource": {
    "type": "prometheus",
    "uid": "agw-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (effect, level) (rate(agw_risk_decisions_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "agw-prometheus"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
